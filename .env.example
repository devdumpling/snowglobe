# Database connection (used by SvelteKit)
# Default matches compose.yaml - change both for production
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# Party access code (guests need this to register)
# Should match site.json partyCode value
PARTY_CODE="demo2025"

# WebSocket server URL (for production, set to deployed backend URL)
PUBLIC_WS_URL=ws://localhost:4000/ws
